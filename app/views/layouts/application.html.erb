<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Runabout · Second screen</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link id="lcars-theme" rel="stylesheet" href="/lcars/classic.css" data-turbo-permanent>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="runabout">
    <a class="skip-link" data-turbo="false" href="#cast">Skip to panels</a>
    <% flash.each do |_type, message| %><p class="notice" role="status"><%= message %></p><% end %>
    <%= yield %>
    <footer class="attribution">
      Memory Alpha content: <a href="https://memory-alpha.fandom.com">Memory Alpha</a> · CC BY-NC · Non-commercial use.<br>
      This product uses the TMDB API but is not endorsed or certified by TMDB.<br>
      LCARS Inspired Website Template by <a href="https://www.thelcars.com">www.TheLCARS.com</a>.
    </footer>
  </body>
</html>
